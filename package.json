{
  "name": "poker-table",
  "version": "0.1.0",
  "private": true,
  "description": "Hand-drawn 3D-style manual Texas Hold'em table for desktop (Electron) and browser",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "npm run build && node scripts/electron.mjs --prod",
    "electron:dev": "node scripts/electron.mjs",
    "dist:mac": "npm run build && npx --yes electron-builder@26 --mac",
    "sim": "node scripts/sim.mjs",
    "gateway": "node scripts/bot-gateway.mjs",
    "bots:setup": "sh scripts/setup-external-bots.sh"
  },
  "build": {
    "appId": "local.pokertable.app",
    "productName": "Poker Table",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.card-games",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
